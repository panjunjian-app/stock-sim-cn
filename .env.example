# 复制为 .dev.vars（Wrangler 本地）并在 Cloudflare Pages → Settings → Environment variables 配置生产值
# JWT 签名密钥：openssl rand -base64 32 生成，≥32 字节
JWT_SECRET=replace-with-openssl-rand-base64-32

# Resend 发信密钥（https://resend.com 免费版）；本地未配置时验证码会打印到 Functions 控制台
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# 发件人，需为 Resend 已验证域名下的地址；调试可用 onboarding@resend.dev
EMAIL_FROM=炒炒乐 <noreply@yourdomain.dev>
